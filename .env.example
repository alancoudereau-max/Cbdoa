# ================================================================
#  CBDoux — variables d'environnement (toutes facultatives sauf la première)
#  Copiez ce fichier en .env.local (en local) et renseignez les
#  mêmes variables dans Vercel → Project → Settings → Environment Variables
# ================================================================

# URL publique du site (sans slash final) : URLs canoniques, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://cbdoux.fr

# Code de vérification Google Search Console (balise meta) — facultatif
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
