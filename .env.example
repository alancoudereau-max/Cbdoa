# ================================================================
#  CBDoux — variables d'environnement (toutes facultatives)
# ================================================================
#
# Sur Netlify ou Vercel, l'adresse du site est détectée automatiquement
# (domaine principal du projet) : vous n'avez RIEN à renseigner.
#
# Renseignez NEXT_PUBLIC_SITE_URL uniquement si vous hébergez le site ailleurs,
# ou pour forcer une adresse précise (sans slash final) :
# NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.fr

# Code de vérification Google Search Console (balise meta) — facultatif
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
