# ================================================================
#  CBDoux — variables d'environnement
#  Copiez ce fichier en .env.local (en local) et renseignez les
#  mêmes variables dans Vercel → Project → Settings → Environment Variables
# ================================================================

# URL publique du site (sans slash final). Sert aux URLs canoniques, au sitemap,
# aux emails et aux redirections de paiement.
NEXT_PUBLIC_SITE_URL=https://cbdoux.fr

# --- Supabase (base de données des commandes) ------------------
# Project Settings → API. La clé "service_role" est SECRÈTE (serveur uniquement).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Mollie (paiement en ligne) --------------------------------
# Dashboard Mollie → Développeurs → Clés API. Utilisez test_... pour tester,
# live_... une fois le compte validé pour le CBD.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Resend (emails transactionnels) ---------------------------
# https://resend.com → API Keys. Le domaine d'envoi doit être vérifié (DNS).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="CBDoux <commandes@cbdoux.fr>"
# Adresse qui reçoit les notifications de commande et les messages du formulaire de contact
MERCHANT_EMAIL=contact@smart-vend.com

# --- Administration (/admin) -----------------------------------
# Mot de passe long et unique (≥ 16 caractères) + secret aléatoire pour signer le cookie
ADMIN_PASSWORD=changez-moi-mot-de-passe-long
ADMIN_SESSION_SECRET=changez-moi-secret-aleatoire-64-caracteres

# --- SEO / outils (optionnel) ----------------------------------
# Code de vérification Google Search Console (balise meta)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
